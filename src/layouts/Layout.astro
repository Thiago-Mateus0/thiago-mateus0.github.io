---
import "../styles/global.css";
const { title = "Thiago Mateus", description = "" } = Astro.props;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b10" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      const saved = localStorage.getItem("lang");
      const lang = saved || (navigator.language.startsWith("pt") ? "pt" : "en");
      document.documentElement.lang = lang;
    </script>
  </head>
  <body>
    <a class="skip" href="#main"><span data-l="pt">Ir para o conteúdo</span><span data-l="en">Skip to content</span></a>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <slot />
    <script is:inline>
      document.querySelectorAll("[data-set-lang]").forEach((b) =>
        b.addEventListener("click", () => {
          const l = b.getAttribute("data-set-lang");
          document.documentElement.lang = l;
          localStorage.setItem("lang", l);
        }),
      );
      // tilt + brilho que segue o mouse nos cards (só com mouse e sem reduce-motion)
      if (matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
        document.querySelectorAll(".pcard").forEach((c) => {
          c.addEventListener("pointermove", (e) => {
            const r = c.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            c.style.setProperty("--ry", (x - 0.5) * 5 + "deg");
            c.style.setProperty("--rx", (0.5 - y) * 5 + "deg");
            c.style.setProperty("--mx", x * 100 + "%");
            c.style.setProperty("--my", y * 100 + "%");
          });
          c.addEventListener("pointerleave", () => {
            c.style.setProperty("--rx", "0deg");
            c.style.setProperty("--ry", "0deg");
          });
        });
      }
      document.querySelectorAll("[data-more]").forEach((b) =>
        b.addEventListener("click", () => {
          const d = b.previousElementSibling;
          const open = d.classList.toggle("clamp") === false;
          b.setAttribute("aria-expanded", String(open));
          b.querySelectorAll("[data-l]").forEach((s) => (s.hidden = s.dataset.state !== (open ? "less" : "more")));
        }),
      );
      document.querySelectorAll("[data-filter]").forEach((b) =>
        b.addEventListener("click", () => {
          const f = b.getAttribute("data-filter");
          // tilt + brilho que segue o mouse nos cards (só com mouse e sem reduce-motion)
      if (matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
        document.querySelectorAll(".pcard").forEach((c) => {
          c.addEventListener("pointermove", (e) => {
            const r = c.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            c.style.setProperty("--ry", (x - 0.5) * 5 + "deg");
            c.style.setProperty("--rx", (0.5 - y) * 5 + "deg");
            c.style.setProperty("--mx", x * 100 + "%");
            c.style.setProperty("--my", y * 100 + "%");
          });
          c.addEventListener("pointerleave", () => {
            c.style.setProperty("--rx", "0deg");
            c.style.setProperty("--ry", "0deg");
          });
        });
      }
      document.querySelectorAll("[data-more]").forEach((b) =>
        b.addEventListener("click", () => {
          const d = b.previousElementSibling;
          const open = d.classList.toggle("clamp") === false;
          b.setAttribute("aria-expanded", String(open));
          b.querySelectorAll("[data-l]").forEach((s) => (s.hidden = s.dataset.state !== (open ? "less" : "more")));
        }),
      );
      document.querySelectorAll("[data-filter]").forEach((x) =>
            x.toggleAttribute("data-active", x === b),
          );
          document.querySelectorAll("[data-tags]").forEach((c) => {
            c.hidden = f !== "all" && !c.dataset.tags.split(" ").includes(f);
          });
        }),
      );
    </script>
  </body>
</html>
