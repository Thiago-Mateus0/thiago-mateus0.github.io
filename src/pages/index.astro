---
import Layout from "../layouts/Layout.astro";
import T from "../components/T.astro";
import Terminal from "../components/Terminal.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { ArrowRight, ArrowUpRight, ChevronDown, Download, Mail } from "@lucide/astro";
import { profile, projects, focus, timeline, learning } from "../data/content";

const featured = projects.filter((p) => p.featured);
const stack = [...new Set(projects.flatMap((p) => p.stack))];
const aiCount = projects.filter((p) => p.tags.includes("ai")).length;
const [first, ...rest] = profile.name.split(" ");
const last = rest.join(" ");

// seções = unidades do rack (mesma ordem)
const sections = [
  { id: "inicio", u: "AL1", name: "inicio.sh", pt: "Início", en: "Home" },
  { id: "projetos", u: "AL2", name: "projetos/", pt: "Projetos", en: "Projects" },
  { id: "sobre", u: "AL3", name: "eu.md", pt: "Sobre", en: "About" },
  { id: "terminal", u: "AL4", name: "ssh visitante@", pt: "Terminal", en: "Terminal" },
  { id: "contato", u: "AL5", name: "sinal --aberto", pt: "Contato", en: "Contact" },
];
// matriz de pontos decorativa de cada unidade (determinística)
const dm = (seed: number) => Array.from({ length: 21 }, (_, i) => ((i * 7 + seed * 5) % 5) < 2);
---

<Layout
  title={{ pt: `${profile.name} — ${profile.role.pt}`, en: `${profile.name} — ${profile.role.en}` }}
  description={profile.bio}
>
  <header class="hdr">
    <div class="hdr-in">
      <a class="logo" href="#inicio" aria-label="Thiago Mateus">
        <img class="logo-mark" src="/avatar.jpg" alt="" width="28" height="28" />
        thiago<span class="g">/</span>dev
      </a>
      <nav class="nav" aria-label="Principal">
        {sections.slice(1).map((s, i) => (
          <a href={`#${s.id}`} data-nav={s.id}><b>0{i + 2}</b><span data-l="pt">{s.pt}</span><span data-l="en">{s.en}</span></a>
        ))}
      </nav>
      <div class="lang" role="group" aria-label="Idioma">
        <button data-set-lang="pt" aria-label="Português">PT</button>
        <button data-set-lang="en" aria-label="English">EN</button>
      </div>
    </div>
    <div class="bar" aria-hidden="true"><i id="progress"></i></div>
  </header>

  <div class="layout">
    <!-- ============ palco: rack 3D ============ -->
    <aside class="stage" aria-label="Rack">
      <div class="floor" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      <div class="hud" aria-hidden="true">
        <span>rack <b>dev-01</b></span>
        <span>{profile.location}</span>
        <span>UTC−3 · <b id="clock">--:--</b></span>
      </div>

      <div class="rack-scale">
        <div class="rack-bob">
          <div class="rack" id="rack">
            <div class="face f-back"></div>
            <div class="face f-left"></div>
            <div class="face f-right"></div>
            <div class="face f-top"></div>
            <div class="post l"></div><div class="post r"></div>
            <div class="cap t">DEV-01</div><div class="cap b">THIAGO MATEUS</div>

            <div id="units">
              {sections.map((s, i) => (
                <div class="unit" data-unit={s.id} style={`top:${44 + i * 58}px`}>
                  <div class="unit-top"></div><div class="unit-side"></div>
                  <button class="unit-front" data-go={s.id} type="button" aria-label={s.name}>
                    <span class="screws"><i></i><i></i></span>
                    <span class="leds"><i></i><i></i><i></i></span>
                    <span class="u-name"><b>{s.u}</b><span>{s.name}</span></span>
                    <span class="vent"></span>
                    <span class="dm">{dm(i).map((on) => <i class={on ? "on" : ""}></i>)}</span>
                    <span class="u-glow"></span><span class="beam"></span>
                  </button>
                </div>
              ))}
              <div class="unit" style={`top:${44 + 5 * 58}px`}>
                <div class="unit-top"></div><div class="unit-side"></div>
                <div class="unit-front">
                  <span class="screws"><i></i><i></i></span>
                  <span class="fan"><i></i></span><span class="vent"></span><span class="fan"><i></i></span>
                  <span class="screws"><i></i><i></i></span>
                </div>
              </div>
              <div class="unit" style={`top:${44 + 6 * 58}px`}>
                <div class="unit-top"></div><div class="unit-side"></div>
                <div class="unit-front">
                  <span class="screws"><i></i><i></i></span>
                  <span class="ports">{Array.from({ length: 12 }, () => <b />)}</span>
                </div>
              </div>
            </div>

            <div class="door" id="door" aria-hidden="true">
              <div class="door-lcd"><i></i>DEV-01 · NO AR</div>
              <div class="door-handle"></div>
              <div class="door-hint">▼ scroll</div>
            </div>
          </div>
        </div>
      </div>

      <div class="segs" id="segs" aria-hidden="true">{sections.map(() => <i />)}</div>
    </aside>

    <!-- ============ conteúdo ============ -->
    <main id="main" class="content">
      <!-- U01 -->
      <section class="hero" id="inicio">
        <div class="boot" aria-hidden="true">
          <span style="animation-delay:0.1s">&gt; iniciando o servidor ........  <b>ok</b></span>
          <span style="animation-delay:0.6s">&gt; montando /projetos ........ <b>ok</b></span>
          <span style="animation-delay:1.1s">&gt; status: <b>online</b> · {profile.location}</span>
        </div>

        <h1 class="name" aria-label={profile.name}>
          <span class="ln" aria-hidden="true">
            {[...first].map((c, i) => <span class="ch" style={`animation-delay:${0.2 + i * 0.05}s`}>{c}</span>)}
          </span>
          <span class="ln ln2" aria-hidden="true">
            <span>{[...last].map((c, i) => <span class="ch" style={`animation-delay:${0.5 + i * 0.05}s`}>{c}</span>)}</span>
            <span class="cur"></span>
          </span>
        </h1>

        <div class="hero-row fade" style="animation-delay:1.3s">
          <div class="lead">
            <p class="lead-t"><T t={profile.bio} /></p>
            <p class="lead-s mono"><span class="g"><T t={profile.role} /></span> · <T t={focus} /></p>
          </div>
          <figure class="badge-id">
            <div class="badge-ph">
              <img src="/thiago.jpg" alt="Thiago Mateus" width="240" height="360" fetchpriority="high" />
              <i class="scan" aria-hidden="true"></i>
            </div>
            <figcaption class="mono">
              <span><b>TM-001</b> · <T t={{ pt: "OPERADOR", en: "OPERATOR" }} /></span>
              <span><i class="live"></i> BRT · <b id="clock2">--:--</b></span>
            </figcaption>
          </figure>
        </div>

        <div class="ctas fade" style="animation-delay:1.5s">
          <a class="btn" href="#projetos"><T t={{ pt: "VER AS OBRAS", en: "SEE THE WORK" }} /> <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="ghost big" data-l="pt" href="/curriculo-thiago-mateus.pdf" download><Download size={16} aria-hidden="true" /> meu currículo</a>
          <a class="ghost big" data-l="en" href="/curriculo-thiago-mateus-en.pdf" download><Download size={16} aria-hidden="true" /> my résumé</a>
          <a class="ghost big" href="#contato"><T t={{ pt: "mandar sinal", en: "send a signal" }} /></a>
        </div>

        <p class="meta fade" style="animation-delay:1.7s">
          <span>{profile.location}</span><span aria-hidden="true">·</span>
          <a href={profile.github} target="_blank" rel="noopener">github</a><span aria-hidden="true">·</span>
          <a href={profile.linkedin} target="_blank" rel="noopener">linkedin</a>
        </p>
      </section>

      <!-- U02 projetos -->
      <section class="sec" id="projetos">
        <div class="blade hot">
          <div class="bh"><span><span class="leds"><i></i><i></i><i></i></span>AL2 · PROJETOS/</span><span class="st">● {projects.length} <T t={{ pt: "PROJETOS", en: "PROJECTS" }} /></span></div>
          <div class="bb">
            <h2 class="h2"><T t={{ pt: "O que eu construí", en: "What I've built" }} /></h2>
            <div class="filters">
              <button data-filter="all" data-active class="chip"><T t={{ pt: "todos", en: "all" }} /></button>
              <button data-filter="web" class="chip">web</button>
              <button data-filter="ai" class="chip">ai</button>
            </div>
            <div class="projs">
              {featured.map((p) => <ProjectCard p={p} n={projects.indexOf(p) + 1} />)}
            </div>
            <button type="button" class="btn-all" data-all-open>
              <T t={{ pt: `VER TODOS OS ${projects.length} PROJETOS`, en: `SEE ALL ${projects.length} PROJECTS` }} /> <ArrowRight size={18} aria-hidden="true" />
            </button>
          </div>
        </div>
      </section>

      <!-- U03 sobre -->
      <section class="sec" id="sobre">
        <div class="blade">
          <div class="bh"><span><span class="leds"><i></i><i></i><i></i></span>AL3 · EU.MD</span><span class="st">● HEAD</span></div>
          <div class="bb">
            <h2 class="h2"><T t={{ pt: "Banco, API e tela.", en: "Database, API and UI." }} /> <em><T t={{ pt: "IA só onde ajuda.", en: "AI only where it helps." }} /></em></h2>
            <p class="p"><T t={profile.bio} /></p>

            <div class="stats">
              <div><b>{projects.length}</b><span><T t={{ pt: "projetos", en: "projects" }} /></span></div>
              <div><b>{stack.length}</b><span><T t={{ pt: "tecnologias", en: "technologies" }} /></span></div>
              <div><b>{aiCount}</b><span><T t={{ pt: "com módulo de IA", en: "with an AI module" }} /></span></div>
            </div>

            <div class="code">
              <div class="code-h"><span>thiago.ts</span><span>TypeScript</span></div>
              <div class="code-b">
                <div><span>1</span><span><span class="kw">export const</span> thiago = &#123;</span></div>
                <div><span>2</span><span>  role: <span class="st2">"<T t={profile.role} />"</span>,</span></div>
                <div><span>3</span><span>  base: <span class="st2">"{profile.location}"</span>,</span></div>
                <div><span>4</span><span>  stack: [{stack.map((s, i) => <><span class="st2">"{s}"</span>{i < stack.length - 1 ? ", " : ""}</>)}],</span></div>
                <div><span>5</span><span>  learning: [{learning.map((s, i) => <><span class="st2">"{s}"</span>{i < learning.length - 1 ? ", " : ""}</>)}],</span></div>
                <div><span>6</span><span>  focus: <span class="st2">"<T t={focus} />"</span>,</span></div>
                <div><span>7</span><span>&#125; <span class="kw">as const</span>;</span></div>
              </div>
            </div>
          </div>
        </div>

        <div class="blade">
          <div class="bh"><span><span class="leds"><i></i><i></i><i></i></span>GIT LOG --ONELINE</span><span class="st">● <T t={{ pt: "TRAJETÓRIA", en: "JOURNEY" }} /></span></div>
          <div class="bb">
            <ol class="tl">
              {timeline.map((i, idx) => (
                <li class={`${i.kind}${idx === 0 ? " head" : ""}`}>
                  <span class="n" aria-hidden="true"></span>
                  <div>
                    <p class="when">{i.period} {idx === 0 && <span class="headtag">HEAD</span>}</p>
                    <h3><T t={i.title} /></h3>
                    {i.place && <p class="role">@ {i.place}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- U04 terminal -->
      <section class="sec" id="terminal">
        <div class="blade">
          <div class="bh"><span><span class="leds"><i></i><i></i><i></i></span>AL4 · SSH VISITANTE@DEV</span><span class="st">● <T t={{ pt: "INTERATIVO", en: "INTERACTIVE" }} /></span></div>
          <div class="bb">
            <h2 class="h2"><T t={{ pt: "Manda um comando.", en: "Send a command." }} /></h2>
            <Terminal />
          </div>
        </div>
      </section>

      <!-- U05 contato -->
      <section class="sec" id="contato">
        <div class="blade hot">
          <div class="bh"><span><span class="leds"><i></i><i></i><i></i></span>AL5 · SINAL --ABERTO</span><span class="st">● <T t={{ pt: "NO AR", en: "ON AIR" }} /></span></div>
          <div class="bb">
            <h2 class="h2"><T t={{ pt: "Quer ver o código?", en: "Want to see the code?" }} /></h2>
            <p class="p"><T t={{ pt: "Estou buscando estágio em desenvolvimento. Se tem uma vaga, ou quer que eu explique como algum projeto funciona por dentro, manda mensagem.", en: "I'm looking for a development internship. If you have an opening, or want me to walk you through how any of these projects works inside, send a message." }} /></p>
            <figure class="sig" id="sig">
              <svg viewBox="131 133 1280 581" role="img" aria-label={`Assinatura de ${profile.name}`}>
                <defs>
                  <mask id="sigmask" maskUnits="userSpaceOnUse" x="131" y="133" width="1280" height="581">
                    <g fill="none" stroke="#fff" stroke-width="46" stroke-linecap="round" stroke-linejoin="round">
                      <path pathLength="1" style="--d:0s;--t:1.3s" d="M505 710 L560 610 L680 360 C735 260 800 150 862 142 C885 165 850 235 705 300 C600 345 470 385 392 372 C368 352 385 318 455 296 C560 270 650 272 705 300" />
                      <path pathLength="1" style="--d:1.2s;--t:1.7s" d="M1220 205 C900 300 500 420 300 520 C200 570 140 610 140 640 C160 655 400 635 900 595 C1150 575 1330 525 1395 475 C1415 440 1370 425 1300 430 C1150 440 1000 490 900 525" />
                      <path pathLength="1" style="--d:2.8s;--t:0.9s" d="M610 595 L905 348 L775 578 L930 437 C935 480 905 500 895 520" />
                    </g>
                    <circle class="dot" cx="993" cy="372" r="30" fill="#fff" />
                  </mask>
                </defs>
                <image href="/assinatura.png" x="131" y="133" width="1280" height="581" mask="url(#sigmask)" />
              </svg>
            </figure>
            {profile.email && (
              <div class="mailcta">
                <a class="btn" href={`mailto:${profile.email}?subject=${encodeURIComponent("Contato pelo portfólio")}`}>
                  <Mail size={18} aria-hidden="true" /> <T t={{ pt: "ENVIAR UM E-MAIL", en: "SEND ME AN EMAIL" }} />
                </a>
                <a class="mailaddr" href={`mailto:${profile.email}`}>{profile.email}</a>
              </div>
            )}
            <div class="social">
              <a class="ghost big" href={profile.linkedin} target="_blank" rel="noopener">linkedin <ArrowUpRight size={16} aria-hidden="true" /></a>
              <a class="ghost big" href={profile.github} target="_blank" rel="noopener">github <ArrowUpRight size={16} aria-hidden="true" /></a>
            </div>
            <div class="cvs">
              <a class="cv primary" data-l="pt" href="/curriculo-thiago-mateus.pdf" download>
                <span><b>LEVAR O CURRÍCULO</b><small>PDF · PT</small></span>
                <Download size={20} aria-hidden="true" />
              </a>
              <a class="cv primary" data-l="en" href="/curriculo-thiago-mateus-en.pdf" download>
                <span><b>TAKE THE RÉSUMÉ</b><small>PDF · EN</small></span>
                <Download size={20} aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
        <footer class="foot">
          <span>© 2026 {profile.name}</span>
          <span>rack dev-01 · al5</span>
        </footer>
      </section>
    </main>
  </div>

  <dialog id="all-projects" class="all-dlg" aria-label="Projetos / Projects">
    <div class="all-h">
      <span><T t={{ pt: "TODOS OS PROJETOS", en: "ALL PROJECTS" }} /> · {projects.length}</span>
      <button type="button" class="more" data-all-close aria-label="Fechar / close">✕ <T t={{ pt: "fechar", en: "close" }} /></button>
    </div>
    <div class="all-grid">
      {projects.map((p, i) => <ProjectCard p={p} n={i + 1} compact />)}
    </div>
  </dialog>

  <dialog id="lightbox" class="lightbox" aria-label="Screenshot">
    <img id="lightbox-img" alt="" />
  </dialog>

  <script is:inline>
    const allDlg = document.getElementById("all-projects");
    document.addEventListener("click", (e) => {
      if (e.target.closest("[data-all-open]")) allDlg.showModal();
      else if (e.target.closest("[data-all-close]") || e.target === allDlg) allDlg.close();
    });
    const lb = document.getElementById("lightbox");
    const lbImg = document.getElementById("lightbox-img");
    document.addEventListener("click", (e) => {
      const z = e.target.closest("[data-zoom]");
      if (z) { lbImg.src = z.dataset.zoom; lbImg.alt = z.dataset.alt || ""; lb.showModal(); }
      else if (e.target === lb || e.target === lbImg) lb.close();
    });
  </script>

  <script is:inline>
    const ids = ["inicio", "projetos", "sobre", "terminal", "contato"];
    const secs = ids.map((id) => document.getElementById(id));
    const units = ids.map((id) => document.querySelector(`[data-unit="${id}"]`));
    const segs = [...document.querySelectorAll("#segs i")];
    const rack = document.getElementById("rack");
    const door = document.getElementById("door");
    const bar = document.getElementById("progress");
    const links = [...document.querySelectorAll("[data-nav]")];
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // ângulo de giro do rack em cada seção
    const yaw = [40, -32, 30, -22, 26];
    let ry = yaw[0], active = -1, ticking = false;

    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));

    function update() {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
      door.style.setProperty("--door", clamp(scrollY / (innerHeight * 0.7), 0, 1));

      // seção mais próxima do meio da tela
      let best = 0, dist = Infinity;
      secs.forEach((s, i) => {
        const r = s.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - innerHeight / 2);
        if (d < dist) { dist = d; best = i; }
      });
      if (scrollY + innerHeight >= document.documentElement.scrollHeight - 4) best = ids.length - 1;
      if (best !== active) {
        active = best;
        units.forEach((u, i) => u.classList.toggle("on", i === best));
        segs.forEach((s, i) => { s.className = i === best ? "on" : i < best ? "done" : ""; });
        links.forEach((a) => a.setAttribute("aria-current", String(a.dataset.nav === ids[best])));
      }
    }
    const req = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener("scroll", req, { passive: true });
    addEventListener("resize", req);

    // giro suave do rack até o ângulo da seção ativa
    function spin() {
      const target = yaw[Math.max(active, 0)];
      ry += (target - ry) * (calm ? 1 : 0.06);
      rack.style.setProperty("--ry", ry.toFixed(2) + "deg");
      requestAnimationFrame(spin);
    }
    update();
    spin();

    document.querySelectorAll("[data-go]").forEach((b) =>
      b.addEventListener("click", () => document.getElementById(b.dataset.go).scrollIntoView({ behavior: calm ? "auto" : "smooth" })),
    );
    addEventListener("keydown", (e) => {
      const t = e.target;
      if (e.metaKey || e.ctrlKey || e.altKey || t.tagName === "INPUT" || t.tagName === "TEXTAREA") return;
      const n = Number(e.key);
      if (n >= 1 && n <= ids.length) secs[n - 1].scrollIntoView({ behavior: calm ? "auto" : "smooth" });
    });

    // assinatura: as matrizes de LED acendem conforme o cursor cruza o palco
    const stage = document.querySelector(".stage");
    const dms = [...document.querySelectorAll(".dm")];
    if (!calm) stage.addEventListener("pointermove", (e) => {
      const b = stage.getBoundingClientRect();
      const n = Math.round(((e.clientX - b.left) / b.width) * 21);
      dms.forEach((d) => [...d.children].forEach((c, i) => c.classList.toggle("hot", i < n)));
    }, { passive: true });

    // assinatura: desenha o traço ao entrar na tela
    const sig = document.getElementById("sig");
    if (calm) sig.classList.add("in");
    else new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { sig.classList.add("in"); o.disconnect(); } }), { threshold: 0.6 }).observe(sig);

    // relógio (horário de Brasília)
    const clock = document.getElementById("clock"), clock2 = document.getElementById("clock2");
    const fmt = new Intl.DateTimeFormat("pt-BR", { hour: "2-digit", minute: "2-digit", timeZone: "America/Sao_Paulo" });
    const tick = () => (clock.textContent = clock2.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 15000);
  </script>
</Layout>
