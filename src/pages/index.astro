---
import Layout from "../layouts/Layout.astro";
import T from "../components/T.astro";
import Terminal from "../components/Terminal.astro";
import NavLinks from "../components/NavLinks.astro";
import { profile, projects, focus, timeline, learning } from "../data/content";

const stack = [...new Set(projects.flatMap((p) => p.stack))];
const aiCount = projects.filter((p) => p.tags.includes("ai")).length;
const head = timeline[0];

type Unit = {
  id: string;
  u: string;
  name: string;
  status: { pt: string; en: string };
  led: "green" | "amber";
};

const units: Unit[] = [
  {
    id: "projetos",
    u: "U01",
    name: "projects/",
    status: {
      pt: `${projects.length} projetos · ${aiCount} com IA`,
      en: `${projects.length} projects · ${aiCount} with AI`,
    },
    led: "green",
  },
  {
    id: "sobre",
    u: "U02",
    name: "about.md",
    status: {
      pt: `${stack.length} tecnologias · HEAD ${head?.place ?? "—"}`,
      en: `${stack.length} technologies · HEAD ${head?.place ?? "—"}`,
    },
    led: "green",
  },
  {
    id: "terminal",
    u: "U03",
    name: "ssh visitor@",
    status: { pt: "terminal interativo", en: "interactive terminal" },
    led: "amber",
  },
  {
    id: "contato",
    u: "U04",
    name: "contact --open",
    status: { pt: "disponível para conversar", en: "open to talk" },
    led: "green",
  },
];
---

<Layout title={`${profile.name} — ${profile.role.en}`}>
  <div class="shell">
    <header class="top">
      <a class="logo" href="/" aria-label="thiago.dev">thiago<span class="dot tld">.dev</span><span class="caret" aria-hidden="true">_</span></a>
      <NavLinks />
      <div class="lang">
        <button data-set-lang="pt" class="lang-btn" aria-label="Português">PT</button>
        <span aria-hidden="true">/</span>
        <button data-set-lang="en" class="lang-btn" aria-label="English">EN</button>
      </div>
    </header>

    <main id="main" class="rack" aria-label="Rack">
      <div class="rail rail-l" aria-hidden="true"></div>
      <div class="rail rail-r" aria-hidden="true"></div>

      <section class="unit unit-hero" style="--i:0">
        <p class="eyebrow"><span class="led led-green" aria-hidden="true"></span>rack sp-01 · {profile.location}</p>
        <h1 class="hero-name">{profile.name}</h1>
        <p class="hero-role"><T t={profile.role} /></p>
        <p class="hero-bio"><T t={profile.bio} /></p>
        <p class="hero-focus"><span class="mark"><T t={focus} /></span></p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#projetos" data-open="projetos">
            <T t={{ pt: "Ver projetos", en: "See projects" }} /> <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn" href="#contato" data-open="contato">
            <T t={{ pt: "Falar comigo", en: "Get in touch" }} />
          </a>
        </div>
      </section>

      {units.map((m, i) => (
        <button class="unit unit-mod" data-open={m.id} type="button" style={`--i:${i + 1}`}>
          <span class="u-id">{m.u}</span>
          <span class={`led led-${m.led}`} aria-hidden="true"></span>
          <span class="u-name">{m.name}</span>
          <span class="u-status"><T t={m.status} /></span>
          <span class="u-go"><kbd>{i + 1}</kbd> <T t={{ pt: "entrar", en: "enter" }} /> →</span>
          <span class="u-vents" aria-hidden="true"></span>
        </button>
      ))}
    </main>

    <p class="hint">
      <T
        t={{
          pt: "clique num módulo ou aperte 1–4 · esc para voltar ao rack",
          en: "click a module or press 1–4 · esc to return to the rack",
        }}
      />
    </p>
  </div>

  <dialog id="room" class="room" aria-label="Módulo">
    <div class="room-bar">
      <span class="accent mono text-sm" id="room-title">~</span>
      <NavLinks />
      <button id="room-close" type="button" class="chip">
        <T t={{ pt: "voltar ao rack", en: "back to rack" }} />&nbsp;<kbd>esc</kbd>
      </button>
      <div class="progress" id="room-progress" aria-hidden="true" style="position:absolute;bottom:-1px;top:auto"></div>
    </div>

    <div class="room-body" id="room-body" tabindex="-1">
      <!-- U01 projetos -->
      <section data-panel="projetos" hidden>
        <p class="panel-cmd" style="--i:0">$ ls projects/</p>
        <h2 class="panel-title" style="--i:1"><T t={{ pt: "Projetos", en: "Projects" }} /></h2>
        <div class="filters" style="--i:2">
          <button data-filter="all" data-active class="chip">
            <T t={{ pt: "todos", en: "all" }} />
          </button>
          <button data-filter="web" class="chip">web</button>
          <button data-filter="ai" class="chip">ai</button>
        </div>
        <div class="mt-6 grid gap-4 lg:grid-cols-2" style="--i:3">
          {projects.map((p) => (
            <article data-tags={p.tags.join(" ")} class="card pcard">
              <div class="flex items-center gap-2">
                <h2>{p.name}</h2>
                {p.tags.includes("ai") && <span class="badge">AI</span>}
              </div>
              <div class="stack">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
              <p class="desc clamp"><T t={p.desc} /></p>
              <button type="button" class="more" data-more aria-expanded="false">
                <span data-l="pt" data-state="more">ler mais ↓</span><span data-l="pt" data-state="less" hidden>mostrar menos ↑</span>
                <span data-l="en" data-state="more">read more ↓</span><span data-l="en" data-state="less" hidden>show less ↑</span>
              </button>
              {p.ai && (
                <div class="ai-block">
                  <h3><T t={{ pt: "Módulo de IA", en: "AI module" }} />: {p.ai.name}</h3>
                  <p class="desc clamp mt-2"><T t={p.ai.desc} /></p>
                  <button type="button" class="more" data-more aria-expanded="false">
                    <span data-l="pt" data-state="more">ler mais ↓</span><span data-l="pt" data-state="less" hidden>mostrar menos ↑</span>
                    <span data-l="en" data-state="more">read more ↓</span><span data-l="en" data-state="less" hidden>show less ↑</span>
                  </button>
                  <div class="stack mt-2">{p.ai.stack.map((s) => <span class="chip">{s}</span>)}</div>
                </div>
              )}
              {(p.demo || p.repo) && (
                <div class="links">
                  {p.demo && <a class="btn btn-primary" href={p.demo} target="_blank" rel="noopener">demo ↗</a>}
                  {p.repo && <a class="btn" href={p.repo} target="_blank" rel="noopener">GitHub ↗</a>}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>

      <!-- U02 sobre -->
      <section data-panel="sobre" hidden>
        <p class="panel-cmd" style="--i:0">$ cat about.md</p>
        <h2 class="panel-title" style="--i:1"><T t={{ pt: "Sobre", en: "About" }} /></h2>
        <p class="hero-bio" style="--i:2"><T t={profile.bio} /></p>
        <p class="hero-focus" style="--i:2"><span class="mark"><T t={focus} /></span></p>

        <p class="panel-cmd mt-10" style="--i:3">$ cat stack.txt</p>
        <div class="stack mt-4" style="--i:3">
          {stack.map((s) => <span class="chip">{s}</span>)}
        </div>
        <p class="panel-cmd mt-10" style="--i:4">$ echo $LEARNING</p>
        <div class="stack mt-4" style="--i:4">
          {learning.map((s) => <span class="chip chip-hot">{s}</span>)}
        </div>

        <p class="panel-cmd mt-10" style="--i:5">$ git log --oneline</p>
        <ol class="log mt-6" style="--i:5">
          {timeline.map((i, idx) => (
            <li>
              <span class="dot" aria-hidden="true"></span>
              <p class="faint text-sm">
                {idx === 0 && <span class="accent">HEAD → </span>}{i.period}
                <span class="tag ml-2">{i.kind === "work" ? "work" : "edu"}</span>
              </p>
              <p class="mt-1 text-lg"><T t={i.title} /></p>
              {i.place && <p class="muted text-sm">@ {i.place}</p>}
            </li>
          ))}
        </ol>
      </section>

      <!-- U03 terminal -->
      <section data-panel="terminal" hidden>
        <p class="panel-cmd" style="--i:0">$ ssh visitor@portfolio</p>
        <div class="mt-4" style="--i:1"><Terminal /></div>
      </section>

      <!-- U04 contato -->
      <section data-panel="contato" hidden>
        <p class="panel-cmd" style="--i:0">$ contact --open</p>
        <h2 class="panel-title" style="--i:1"><T t={{ pt: "Vamos conversar?", en: "Let's talk?" }} /></h2>
        <div class="mt-8 grid gap-3 sm:grid-cols-2" style="--i:2">
          {profile.email && (
            <a class="card contact" href={`mailto:${profile.email}`}>e-mail <span class="arrow" aria-hidden="true">↗</span></a>
          )}
          <a class="card contact" href={profile.linkedin} target="_blank" rel="noopener">linkedin <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="card contact" href={profile.github} target="_blank" rel="noopener">github <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="card contact" href="/curriculo-thiago-mateus.pdf" download>
            <span><T t={{ pt: "currículo", en: "résumé" }} /></span> <span class="arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </section>
    </div>
  </dialog>

  <script>
    const room = document.getElementById("room") as HTMLDialogElement;
    const title = document.getElementById("room-title")!;
    const panels = [...room.querySelectorAll<HTMLElement>("[data-panel]")];
    const names: Record<string, string> = {
      projetos: "U01 · projects/",
      sobre: "U02 · about.md",
      terminal: "U03 · ssh visitor@",
      contato: "U04 · contact --open",
    };
    const ids = Object.keys(names);
    const body = document.getElementById("room-body")!;
    const bar = document.getElementById("room-progress")!;
    body.addEventListener("scroll", () => {
      const max = body.scrollHeight - body.clientHeight;
      bar.style.transform = `scaleX(${max > 0 ? body.scrollTop / max : 0})`;
    }, { passive: true });
    window.addEventListener("scroll", () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      document.getElementById("progress")!.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    }, { passive: true });
    let closing = false;

    function show(id: string) {
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      title.textContent = names[id];
      body.scrollTop = 0;
      bar.style.transform = "scaleX(0)";
      room.querySelectorAll<HTMLElement>(".room-bar [data-open]").forEach((a) =>
        a.setAttribute("aria-current", String(a.dataset.open === id)),
      );
      if (!room.open) room.showModal();
      room.classList.remove("closing");
      document.documentElement.classList.add("locked");
      if (id === "terminal") document.getElementById("term-in")?.focus();
      else body.focus({ preventScroll: true });
    }

    function hide() {
      if (!room.open || closing) return;
      closing = true;
      room.classList.add("closing");
      setTimeout(() => {
        room.close();
        room.classList.remove("closing");
        document.documentElement.classList.remove("locked");
        closing = false;
      }, 180);
    }

    function open(id: string) {
      if (!ids.includes(id)) return;
      // trocar de sala dentro de uma sala não empilha histórico
      if (room.open) history.replaceState({ m: id }, "", "#" + id);
      else history.pushState({ m: id }, "", "#" + id);
      show(id);
    }

    function close() {
      if (history.state?.m) history.back();
      else hide();
    }

    document.querySelectorAll<HTMLElement>("[data-open]").forEach((b) =>
      b.addEventListener("click", (e) => {
        e.preventDefault();
        open(b.dataset.open!);
      }),
    );
    document.getElementById("room-close")!.addEventListener("click", close);
    room.addEventListener("cancel", (e) => {
      e.preventDefault();
      close();
    });
    window.addEventListener("popstate", (e) => {
      if (e.state?.m) show(e.state.m);
      else hide();
    });
    window.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (room.open || e.metaKey || e.ctrlKey || e.altKey) return;
      if (t.tagName === "INPUT" || t.tagName === "TEXTAREA") return;
      const n = Number(e.key);
      if (n >= 1 && n <= ids.length) open(ids[n - 1]);
    });

    const initial = location.hash.slice(1);
    if (ids.includes(initial)) {
      history.replaceState({ m: initial }, "", "#" + initial);
      show(initial);
    }
  </script>
</Layout>
