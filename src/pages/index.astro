---
import Layout from "../layouts/Layout.astro";
import T from "../components/T.astro";
import Terminal from "../components/Terminal.astro";
import { profile, projects, focus, timeline, learning } from "../data/content";
---

<Layout title={`${profile.name} — ${profile.role.en}`}>
  <header class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6 text-sm text-zinc-500">
    <span>{profile.location}</span>
    <div class="flex gap-2">
      <button data-set-lang="pt" class="hover:text-emerald-400">PT</button>
      <span>/</span>
      <button data-set-lang="en" class="hover:text-emerald-400">EN</button>
    </div>
  </header>

  <main class="mx-auto max-w-3xl space-y-16 px-6 pb-24">
    <section>
      <p class="text-emerald-400">$ whoami</p>
      <h1 class="typing mt-2 text-4xl font-bold">{profile.name}</h1>
      <p class="mt-1 text-zinc-400"><T t={profile.role} /></p>
      <p class="mt-4 max-w-xl"><T t={profile.bio} /></p>
      <p class="mt-2 text-sm text-emerald-400">&gt; <T t={focus} /></p>
      <div class="mt-6 flex gap-4 text-sm">
        <a class="underline hover:text-emerald-400" href={profile.github}>github</a>
        <a class="underline hover:text-emerald-400" href={profile.linkedin}>linkedin</a>
        <a class="underline hover:text-emerald-400" href="/curriculo-thiago-mateus.pdf" download>
          <T t={{ pt: "currículo", en: "résumé" }} />
        </a>
      </div>
    </section>

    <section>
      <p class="text-emerald-400">$ ls projects/</p>
      <div class="mt-3 flex gap-2 text-xs">
        <button data-filter="all" data-active class="rounded border border-zinc-700 px-2 py-1">all</button>
        <button data-filter="web" class="rounded border border-zinc-700 px-2 py-1">web</button>
        <button data-filter="ai" class="rounded border border-zinc-700 px-2 py-1">ai</button>
      </div>

      <div class="mt-6 space-y-4">
        {projects.map((p) => (
          <article data-tags={p.tags.join(" ")} class="rounded border border-zinc-800 p-5">
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-semibold">{p.name}</h2>
              {p.tags.includes("ai") && (
                <span class="rounded bg-emerald-400/10 px-2 py-0.5 text-xs text-emerald-400">AI</span>
              )}
            </div>
            <p class="mt-2 text-sm text-zinc-400"><T t={p.desc} /></p>
            {p.stack.length > 0 && (
              <p class="mt-2 text-xs text-zinc-500">{p.stack.join(" · ")}</p>
            )}
            {p.ai && (
              <div class="mt-4 border-l-2 border-emerald-400 pl-4">
                <p class="text-sm font-semibold text-emerald-400">
                  <T t={{ pt: "Módulo de IA", en: "AI module" }} />: {p.ai.name}
                </p>
                <p class="mt-1 text-sm text-zinc-400"><T t={p.ai.desc} /></p>
                <p class="mt-2 text-xs text-zinc-500">{p.ai.stack.join(" · ")}</p>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section>
      <p class="text-emerald-400">$ cat stack.txt</p>
      <p class="mt-2 text-sm text-zinc-400">
        {[...new Set(projects.flatMap((p) => p.stack))].join(" · ")}
      </p>
      <p class="mt-3 text-sm">
        <span class="text-emerald-400">learning:</span> {learning.join(" · ")}
      </p>
    </section>

    {timeline.length > 0 && (
      <section>
        <p class="text-emerald-400">$ git log --oneline</p>
        <ul class="mt-3 space-y-3 text-sm">
          {timeline.map((i) => (
            <li>
              <span class="text-zinc-500">{i.period}</span> —
              <T t={i.title} />{i.place && <span class="text-zinc-500"> @ {i.place}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section>
      <p class="text-emerald-400">$ ssh visitor@portfolio</p>
      <div class="mt-3"><Terminal /></div>
    </section>

    <section>
      <p class="text-emerald-400">$ contact --open</p>
      <p class="mt-2 text-sm text-zinc-400">
        <T t={{ pt: "Vamos conversar?", en: "Let's talk?" }} />
        <a class="underline hover:text-emerald-400" href={profile.linkedin}> linkedin</a>
      </p>
    </section>
  </main>
</Layout>
