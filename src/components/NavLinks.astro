---
// Navegação: cada item abre a sala correspondente do rack
const items = [
  { id: "sobre", pt: "Sobre", en: "About" },
  { id: "projetos", pt: "Projetos", en: "Projects" },
  { id: "contato", pt: "Contato", en: "Contact" },
];
---

<nav class="nav" aria-label="Principal">
  {items.map((i) => (
    <a class="nav-link" href={`#${i.id}`} data-open={i.id}>
      <span data-l="pt">{i.pt}</span><span data-l="en">{i.en}</span>
    </a>
  ))}
</nav>
